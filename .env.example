# Copy to .env. Everything except the key below has a working default in docker-compose.yml.

# --- required for the main scenario ---
OPENAI_API_KEY=sk-...

# --- optional: image generation and fallback LLM via build.nvidia.com ---
NVIDIA_API_KEY=nvapi-...

# --- backend (app/) ---
OPENAI_MODEL=gpt-5.4-mini
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app

# --- frontend (ui/) ---
VITE_API_URL=http://localhost:8000

# --- host ports for docker compose (change if busy) ---
APP_PORT=8000
UI_PORT=5173
DB_PORT=5432
